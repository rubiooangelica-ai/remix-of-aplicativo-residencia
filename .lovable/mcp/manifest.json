          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "reclassificar_questao",
        "title": "Reclassificar questão",
        "description": "Atualiza a classificação de uma questão: área, tema (especialidade) e assunto. Itens que não existirem na taxonomia são criados. Use para correções pontuais e pilotos de validação.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
