          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Id da questão."
            },
            "area": {
              "type": "string",
              "minLength": 1,
              "description": "Nova grande área, ex.: Clínica Médica."
            },
            "tema": {
              "type": "string",
              "minLength": 1,
              "description": "Novo tema/especialidade, ex.: Cardiologia."
            },
            "assunto": {
              "type": "string",
              "minLength": 1,
              "description": "Novo assunto, ex.: Insuficiência Cardíaca."
            }
          },
          "required": [
