                },
                "required": [
                  "id",
                  "area",
                  "tema",
                  "assunto"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 2000,
              "description": "Lista de questões a reclassificar."
            }
          },
          "required": [
            "itens"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
