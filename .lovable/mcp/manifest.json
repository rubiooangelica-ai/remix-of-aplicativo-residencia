  "mcp": {
    "server": {
      "name": "aplicativo-residencia",
      "version": "0.1.0",
      "title": "Aplicativo residencia"
    },
    "tools": [
      {
        "name": "buscar_questoes",
        "title": "Buscar questões",
        "description": "Busca questões do banco por trecho do enunciado, banca, ano, área, tema e/ou assunto. Permite listar apenas questões que têm imagem. Retorna id, enunciado resumido, banca, ano, classificação atual e se há imagem.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "texto": {
              "type": "string",
              "description": "Trecho do enunciado a procurar."
            },
            "banca": {
              "type": "string",
              "description": "Nome da banca (ex.: USP, ABRAMEDE)."
            },
            "ano": {
              "type": "integer",
              "description": "Ano da prova."
            },
            "area": {
              "type": "string",
              "description": "Nome (parcial) da grande área."
            },
            "tema": {
              "type": "string",
              "description": "Nome (parcial) do tema/especialidade."
            },
            "assunto": {
              "type": "string",
              "description": "Nome (parcial) do assunto."
            },
            "apenas_com_imagem": {
              "type": "boolean",
              "description": "Se verdadeiro, retorna somente questões que possuem imagem."
            },
            "limite": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "description": "Máximo de resultados (padrão 10, máximo 30)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "obter_questao",
        "title": "Obter questão completa",
        "description": "Retorna uma questão completa pelo id: enunciado, alternativas, gabarito e comentário, quando existir.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Id da questão."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "listar_temas",
        "title": "Listar áreas e temas",
        "description": "Lista as grandes áreas do banco e seus temas (especialidades). Informe uma área para ver apenas os temas dela.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "area": {
              "type": "string",
              "description": "Nome da grande área, ex.: Clínica Médica."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "estatisticas_taxonomia",
        "title": "Estatísticas da taxonomia",
        "description": "Retorna a contagem de questões agrupada por área → tema → assunto, da maior para a menor. Filtros opcionais por área e tema. Use para dimensionar a organização atual do banco.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "area": {
              "type": "string",
              "description": "Filtra por nome (parcial) da grande área."
            },
            "tema": {
              "type": "string",
              "description": "Filtra por nome (parcial) do tema/especialidade."
            },
            "limite": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000,
              "description": "Máximo de linhas retornadas (padrão 300)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "meu_desempenho",
        "title": "Meu desempenho",
        "description": "Resume o desempenho da pessoa autenticada: total de questões respondidas, acertos, erros e percentual de acertos.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "criar_flashcard",
        "title": "Criar flashcard pessoal",
        "description": "Cria um flashcard pessoal (frente e verso) na conta da pessoa autenticada.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
