        "inputSchema": {
          "type": "object",
          "properties": {
            "itens": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Id da questão."
                  },
                  "area": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Grande área, ex.: Clínica Médica."
                  },
                  "tema": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Tema/especialidade, ex.: Cardiologia."
                  },
                  "assunto": {
                    "type": "string",
                    "minLength": 1,
